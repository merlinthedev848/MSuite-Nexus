# Required: fine-grained PAT (read-only "Contents" + "Metadata") for the private repos you want to expose
# Supports single token or comma-separated pool for automatic failover/rate limit rotation
GITHUB_TOKEN=
# GITHUB_TOKENS=ghp_token1,ghp_token2

# Admin authentication token for Web UI Dashboard and /api/admin/* endpoints
# If left blank, a random one is generated on startup and printed to the console
ADMIN_TOKEN=

# Optional: HMAC-SHA256 secret for GitHub webhook verification (/v1/webhook)
WEBHOOK_SECRET=

PORT=8080
HOST=0.0.0.0
CLIENTS_FILE=./clients.json

# Public URL clients use to reach this proxy (used in rewritten asset download URLs)
PUBLIC_BASE_URL=https://code.example.com

# Set true when running behind a reverse proxy (nginx, Caddy, Cloudflare) so client IPs/protocol are correct
TRUST_PROXY=false

CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500
RATE_LIMIT_PER_MINUTE=120
LOG_REQUESTS=true

# Override only for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
# GITHUB_API_URL=https://api.github.com
